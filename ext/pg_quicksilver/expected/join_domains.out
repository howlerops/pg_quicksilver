(2 rows)

:last
  side  | reason |           detail           
--------+--------+----------------------------
 mirror | routed | quicksilver.route = mirror
(1 row)

SET quicksilver.join_domains = on;
-- the operator differs: a cast to text on one side is not a uuid equality
EXPLAIN (COSTS OFF) SELECT count(*) FROM jd.cust c JOIN jd.ord o ON o.cust::text = c.id::text;
                       QUERY PLAN                        
---------------------------------------------------------
 Aggregate
   ->  Merge Join
         Merge Cond: (((c.id)::text) = ((o.cust)::text))
         ->  Sort
               Sort Key: ((c.id)::text)
               ->  Seq Scan on cust c
         ->  Sort
               Sort Key: ((o.cust)::text)
               ->  Seq Scan on ord o
 Quicksilver: heap (construct not on the allowlist)
(10 rows)

SELECT count(*) FROM jd.cust c JOIN jd.ord o ON o.cust::text = c.id::text;
 count 
-------
     4
(1 row)

:last
 side |             reason             |                         detail                         
------+--------------------------------+--------------------------------------------------------
 heap | construct not on the allowlist | cast pg_catalog.uuid->pg_catalog.text (I/O conversion)
(1 row)

-- two domains: note.cust is in "other", customers.id in "cust"
EXPLAIN (COSTS OFF) SELECT count(*) FROM jd.cust c JOIN jd.note n ON n.cust = c.id;
                 QUERY PLAN                 
--------------------------------------------
 Custom Scan (QuicksilverRoute)
   Quicksilver: mirror
   ->  Aggregate
         ->  Hash Join
               Hash Cond: (n.cust = c.id)
               ->  Seq Scan on note n
               ->  Hash
                     ->  Seq Scan on cust c
(8 rows)

SELECT count(*) FROM jd.cust c JOIN jd.note n ON n.cust = c.id;
 count 
-------
     2
(1 row)

:last
  side  | reason |           detail           
--------+--------+----------------------------
 mirror | routed | quicksilver.route = mirror
(1 row)

