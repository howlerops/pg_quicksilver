-- A mirror that fails under a plan that was made when it worked: what is
-- answered from the heap, what is not, and that nothing is left held.
--
-- There is no subtransaction around the mirror (pg_duckdb refuses one), so the
-- only errors answered from the heap are DuckDB's own, which pg_duckdb raises
-- at its C++ boundary with nothing of PostgreSQL's held. A cancel is rethrown.
-- A leaked buffer pin, relcache reference or lock is reported at commit, and
-- would show in this file's output: there must be none.
\set last 'SELECT side, reason, left(detail, 40) AS detail FROM quicksilver.last_decision();'
SET client_min_messages = warning;
SET search_path = public;
CREATE SCHEMA qt;
CREATE SCHEMA qtm;
CREATE TABLE qt.h (id int PRIMARY KEY, a int, b text);
INSERT INTO qt.h SELECT g, g * 10, 'heap' FROM generate_series(1, 3) g;
-- the mirror is a file, as a lake's data file is
SELECT duckdb.raw_query($$ COPY (SELECT * FROM (VALUES (1, 10, 'mirror'), (2, 20, 'mirror'), (3, 30, 'mirror')) t(id, a, b)) TO '/tmp/qs_regress/errors.parquet' $$);
 raw_query 
-----------
 
(1 row)

CREATE VIEW qtm.h AS SELECT r['id']::int AS id, r['a']::int AS a, r['b']::text AS b
  FROM duckdb.query($$ SELECT * FROM read_parquet('/tmp/qs_regress/errors.parquet') $$) r;
SELECT quicksilver.register_mirror('qt.h', 'qtm.h', 1000000000000);
 register_mirror 
-----------------
 
(1 row)

SELECT quicksilver.report_applied_lsn('qt.h', pg_current_wal_lsn());
 report_applied_lsn 
--------------------
 
(1 row)

SET quicksilver.route = mirror;
SET quicksilver.negative_cache_ttl = 0;
-- ---------------------------------------------------------------- a kept plan, then the file goes
PREPARE kept AS SELECT b, count(*) FROM qt.h GROUP BY b;
EXECUTE kept;
   b    | count 
--------+-------
 mirror |     3
(1 row)

-- the file is replaced by something that is not Parquet (no SQL unlinks a file;
-- to the reader it is the same: the file its plan names cannot be read)
SELECT lo_from_bytea(0, 'not a parquet file') AS lo \gset
SELECT lo_export(:lo, '/tmp/qs_regress/errors.parquet');
 lo_export 
-----------
         1
(1 row)

SELECT lo_unlink(:lo);
 lo_unlink 
-----------
         1
(1 row)

-- outside a transaction block
EXECUTE kept;
  b   | count 
------+-------
 heap |     3
(1 row)

:last
 side |                       reason                       |                  detail                  
------+----------------------------------------------------+------------------------------------------
 heap | mirror failed at execution; answered from the heap | (PGDuckDB/Duckdb_BeginCustomScan_Cpp) Ex
(1 row)

EXECUTE kept;
  b   | count 
------+-------
 heap |     3
(1 row)

-- inside one
SET quicksilver.route_in_transaction = on;
BEGIN;
EXECUTE kept;
  b   | count 
------+-------
 heap |     3
(1 row)

:last
 side |                       reason                       |                  detail                  
------+----------------------------------------------------+------------------------------------------
 heap | mirror failed at execution; answered from the heap | (PGDuckDB/Duckdb_BeginCustomScan_Cpp) Ex
(1 row)

SELECT count(*) FROM qt.h;
 count 
-------
     3
(1 row)

COMMIT;
-- with a cursor, inside a transaction block
BEGIN;
DECLARE c NO SCROLL CURSOR FOR SELECT b, count(*) FROM qt.h GROUP BY b;
FETCH ALL FROM c;
  b   | count 
------+-------
 heap |     3
(1 row)

CLOSE c;
EXECUTE kept;
  b   | count 
------+-------
 heap |     3
(1 row)

COMMIT;
RESET quicksilver.route_in_transaction;
-- ---------------------------------------------------------------- DuckDB raises while it runs
-- the mirror holds a value its own cast cannot take: an error at execution, not at planning
CREATE TABLE qt.e (id int PRIMARY KEY, a int);
INSERT INTO qt.e VALUES (1, 10), (2, 20);
CREATE VIEW qtm.e AS SELECT r['id']::int AS id, r['a']::int AS a
  FROM duckdb.query($$ SELECT id, CASE WHEN id = 2 THEN a::VARCHAR || 'x' ELSE a::VARCHAR END::INTEGER AS a FROM (VALUES (1, 10), (2, 20)) t(id, a) $$) r;
SELECT quicksilver.register_mirror('qt.e', 'qtm.e', 1000000000000);
 register_mirror 
-----------------
 
(1 row)

SELECT quicksilver.report_applied_lsn('qt.e', pg_current_wal_lsn());
 report_applied_lsn 
--------------------
 
(1 row)

SELECT sum(a) FROM qt.e;
 sum 
-----
  30
(1 row)

SELECT side, reason FROM quicksilver.last_decision();
 side |                       reason                       
------+----------------------------------------------------
 heap | mirror failed at execution; answered from the heap
(1 row)

PREPARE bad AS SELECT sum(a) FROM qt.e;
EXECUTE bad;
 sum 
-----
  30
(1 row)

EXECUTE bad;
 sum 
-----
  30
(1 row)

BEGIN;
DECLARE c NO SCROLL CURSOR FOR SELECT id, a FROM qt.e ORDER BY id;
FETCH ALL FROM c;
 id | a  
----+----
  1 | 10
  2 | 20
(2 rows)

COMMIT;
SET quicksilver.route_in_transaction = on;
BEGIN;
SELECT sum(a) FROM qt.e;
 sum 
-----
  30
(1 row)

SELECT sum(a) FROM qt.e;
 sum 
-----
  30
(1 row)

INSERT INTO qt.e VALUES (3, 30);
-- and once the transaction has written, the mirror is not asked at all
SELECT sum(a) FROM qt.e;
 sum 
-----
  60
(1 row)

SELECT side, reason, detail FROM quicksilver.last_decision();
 side |           reason           |                                   detail                                   
------+----------------------------+----------------------------------------------------------------------------
 heap | inside a transaction block | the transaction has written; the mirror cannot see its uncommitted changes
(1 row)

ROLLBACK;
RESET quicksilver.route_in_transaction;
-- without the fallback the client is told what happened
SET quicksilver.fallback = off;
SELECT sum(a) FROM qt.e;
ERROR:  (PGDuckDB/Duckdb_ExecCustomScan_Cpp) Conversion Error: Could not convert string '20x' to INT32

LINE 1: ...(a) AS sum FROM (SELECT m.id, m.a FROM (SELECT (r.id)::integer AS id, (r.a)::integer AS a FROM system.main.query(' SELECT...
                                                                        ^^^^^^^^^
RESET quicksilver.fallback;
-- ---------------------------------------------------------------- a cancel is not an error to answer from the heap
CREATE TABLE qt.slow (id int PRIMARY KEY, n bigint);
INSERT INTO qt.slow VALUES (1, 1);
CREATE VIEW qtm.slow AS SELECT r['id']::int AS id, r['n']::bigint AS n
  FROM duckdb.query($$ SELECT 1 AS id, count(*) AS n FROM range(200000000000) $$) r;
SELECT quicksilver.register_mirror('qt.slow', 'qtm.slow', 1000000000000);
 register_mirror 
-----------------
 
(1 row)

SELECT quicksilver.report_applied_lsn('qt.slow', pg_current_wal_lsn());
 report_applied_lsn 
--------------------
 
(1 row)

-- pg_duckdb reports its own cancel as XX000; the extension answers it as the heap does (57014)
\set VERBOSITY sqlstate
SET statement_timeout = '300ms';
SELECT n FROM qt.slow;
ERROR:  57014
RESET statement_timeout;
\set VERBOSITY default
-- the session is intact, and the heap still answers when asked
SET quicksilver.route = heap;
SELECT n FROM qt.slow;
 n 
---
 1
(1 row)

SET quicksilver.route = mirror;
-- ---------------------------------------------------------------- the mirror fails after rows have left the server
-- The mirror has 2,000,000 rows and its own cast cannot take the value in row
-- 1,800,000. DuckDB finds out after it has started returning rows, and pg_duckdb
-- then ends the result WITHOUT an error (its stream just stops; so does a
-- statement on the mirror relation with no router at all). The router asks
-- DuckDB whether it finished. While the answer fits in work_mem nothing has
-- been sent: the heap (200,000 rows here) answers, all of it, once.
CREATE TABLE qt.big (id int PRIMARY KEY, a int);
INSERT INTO qt.big SELECT g, g FROM generate_series(1, 200000) g;
CREATE VIEW qtm.big AS SELECT r['id']::int AS id, r['a']::int AS a
  FROM duckdb.query($$ SELECT i::int AS id, CASE WHEN i = 1800000 THEN 'x' ELSE i::varchar END AS a FROM range(1, 2000001) t(i) $$) r;
SELECT quicksilver.register_mirror('qt.big', 'qtm.big', 1000000000000);
 register_mirror 
-----------------
 
(1 row)

SELECT quicksilver.report_applied_lsn('qt.big', pg_current_wal_lsn());
 report_applied_lsn 
--------------------
 
(1 row)

SET work_mem = '256MB';
-- pg_duckdb alone, on the mirror relation: rows, then nothing, and no error
\o /tmp/qs_regress/stream.out
SELECT id, a FROM qtm.big;
\o
\! awk 'NF { n++ } END { print ((n > 0 && n < 1800000) ? "some rows, fewer than 1800000" : n " rows") ", and no error above" }' /tmp/qs_regress/stream.out
some rows, fewer than 1800000, and no error above
\set VERBOSITY terse
\set FETCH_COUNT 5000
\t on
\o /tmp/qs_regress/stream.out
SELECT id, a FROM qt.big;
\o
:last
 heap | mirror failed at execution; answered from the heap | the mirror's result ended early: DuckDB 

\! awk 'NF { n++ } END { print n " rows received" }' /tmp/qs_regress/stream.out
200000 rows received
-- Past work_mem the rows are streamed, and the error comes after some of them.
-- The client gets it as an error: the statement fails, the rows it had been
-- sent are fewer than the answer and none of them twice (no second attempt on
-- the heap behind them), and the decision still says "mirror".
SET work_mem = '64kB';
\o /tmp/qs_regress/stream.out
SELECT id, a FROM qt.big;
ERROR:  the mirror failed after rows had been returned
\o
\! awk 'NF { n[$1]++; r++ } END { d = 0; for (k in n) if (n[k] > 1) d++; print ((r > 200000 && r < 1800000) ? "more rows than the heap has, fewer than 1800000" : r " rows") ", " d " received twice" }' /tmp/qs_regress/stream.out
more rows than the heap has, fewer than 1800000, 0 received twice
:last
 mirror | routed | quicksilver.route = mirror

-- the same in a transaction block: there the answer is taken whole before the
-- first row, however large, so the heap can still answer; and the block goes on
BEGIN;
\o /tmp/qs_regress/stream.out
SELECT id, a FROM qt.big;
\o
:last
 heap | mirror failed at execution; answered from the heap | the mirror's result ended early: DuckDB 

\! awk 'NF { n++ } END { print n " rows received" }' /tmp/qs_regress/stream.out
200000 rows received
SAVEPOINT s;
RELEASE s;
COMMIT;
\unset FETCH_COUNT
\t off
-- the session's DuckDB was left holding the result the error interrupted; the next
-- routed statement finds it replaced, and is routed
SELECT count(*) FROM public.customers;
 count 
-------
 10000
(1 row)

:last
  side  | reason |           detail           
--------+--------+----------------------------
 mirror | routed | quicksilver.route = mirror
(1 row)

RESET work_mem;
\set VERBOSITY default
DROP TABLE qt.big;
DROP VIEW qtm.big;
-- ---------------------------------------------------------------- the applied-LSN table gives entries back
-- More registrations than it holds (1024), one after another: every other one
-- is unregistered, the rest have their table dropped under the registry row.
DO $$
BEGIN
  FOR i IN 1..1100 LOOP
    EXECUTE format('CREATE TABLE qt.many_%s (id int PRIMARY KEY)', i);
    EXECUTE format('CREATE VIEW qtm.many_%s AS SELECT r[''id'']::int AS id FROM duckdb.query($q$ SELECT 1 AS id $q$) r', i);
    EXECUTE format('SELECT quicksilver.register_mirror(''qt.many_%s'', ''qtm.many_%s'')', i, i);
    EXECUTE format('SELECT quicksilver.report_applied_lsn(''qt.many_%s'', ''0/10'')', i);
    IF i % 2 = 0 THEN
      EXECUTE format('DELETE FROM quicksilver.mirrors WHERE heap = ''qt.many_%s''::regclass', i);
    END IF;
    EXECUTE format('DROP VIEW qtm.many_%s', i);
    EXECUTE format('DROP TABLE qt.many_%s', i);
  END LOOP;
END $$;
SELECT quicksilver.prune();
 prune 
-------
   551
(1 row)

-- and a table registered after all that is reported and routed
SELECT quicksilver.report_applied_lsn('qt.h', pg_current_wal_lsn());
 report_applied_lsn 
--------------------
 
(1 row)

SELECT fresh FROM quicksilver.mirror_status() WHERE heap = 'qt.h'::regclass;
 fresh 
