--------+--------
 mirror | routed
(1 row)

RESET quicksilver.min_rows;
RESET quicksilver.min_cost;
-- heap: never; mirror: whatever the cost
SET quicksilver.route = heap;
SELECT count(*) FROM orders;
  count  
---------
 1000000
