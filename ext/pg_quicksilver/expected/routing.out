SET quicksilver.min_cost = 5;
SELECT * FROM orders WHERE id = 4242;
  id  | customer_id | status  | amount |          created_at          |  note  
------+-------------+---------+--------+------------------------------+--------
 4242 |           1 | shipped |  42.42 | Sun Dec 31 17:10:42 2023 PST | n-4242
(1 row)

:last
