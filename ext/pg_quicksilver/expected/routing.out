(1 row)

:last
 side |                 reason                 
------+----------------------------------------
 heap | reads a relation with no usable mirror
(1 row)

EXPLAIN (COSTS OFF) SELECT count(*) FROM orders o JOIN audit_log a ON a.id = o.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Aggregate
   ->  Merge Join
         Merge Cond: (o.id = a.id)
         ->  Index Only Scan using orders_pkey on orders o
         ->  Index Only Scan using audit_log_pkey on audit_log a
 Quicksilver: heap (reads a relation with no usable mirror)
(6 rows)

-- a statement that reads no mirrored table is not the extension's business
SELECT quicksilver.forget_last();
 forget_last 
