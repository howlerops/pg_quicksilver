(3 rows)

SET quicksilver.route = off;
DELETE FROM quicksilver.mirrors WHERE heap IN ('kw.h'::regclass, 'kw.m'::regclass, 'kw.at'::regclass);
DROP SCHEMA kw, kwm CASCADE;
SELECT quicksilver.prune();
 prune 
-------
     0
