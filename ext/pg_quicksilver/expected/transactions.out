COMMIT;
-- DuckDB used directly in the block (a superuser can): its DuckDB transaction is
-- not the router's to end, so nothing is routed after it; and the error the
-- SAVEPOINT then gets is pg_duckdb's own, with the router or without
BEGIN;
SELECT * FROM duckdb.query($$ SELECT 42 AS x $$);
 x  
----
 42
(1 row)

:r
  b   | count 
------+-------
 heap |     5
(1 row)

:side
 side |           reason           |                                           detail                                            
------+----------------------------+---------------------------------------------------------------------------------------------
 heap | inside a transaction block | the transaction has used DuckDB directly: its DuckDB transaction is not the router's to end
(1 row)

SAVEPOINT a;
ERROR:  (PGDuckDB/DuckdbSubXactCallback_Cpp) Not implemented Error: SAVEPOINT is not supported in DuckDB
ROLLBACK;
-- the next transaction is routed again
BEGIN;
:r
   b    | count 
--------+-------
 mirror |     5
(1 row)

:side
  side  | reason |           detail           
--------+--------+----------------------------
 mirror | routed | quicksilver.route = mirror
(1 row)

COMMIT;
\set VERBOSITY default
DROP SCHEMA qt, qtm CASCADE;
