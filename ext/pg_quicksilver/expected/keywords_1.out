-- 108 columns named after DuckDB keywords, a keyword-named schema and table, and a keyword join column.
-- Stock pg_duckdb refuses the table (its names cannot be written in DuckDB SQL); the patched build
-- quotes them, so it is mirrored and routed. Every answer must equal the heap's.
CREATE TABLE kw.all108 (id int PRIMARY KEY, "all" int, "analyse" int, "analyze" int, "and" int, "anti" int, "any" int, "array" int, "as" int, "asc" int, "asof" int, "asymmetric" int, "at" int, "authorization" int, "binary" int, "both" int, "by" int, "case" int, "cast" int, "check" int, "collate" int, "collation" int, "column" int, "columns" int, "concurrently" int, "constraint" int, "create" int, "cross" int, "default" int, "deferrable" int, "desc" int, "describe" int, "distinct" int, "do" int, "else" int, "end" int, "except" int, "exclude" int, "false" int, "fetch" int, "for" int, "foreign" int, "freeze" int, "from" int, "full" int, "glob" int, "group" int, "having" int, "ilike" int, "in" int, "initially" int, "inner" int, "intersect" int, "into" int, "is" int, "isnull" int, "join" int, "lambda" int, "lateral" int, "leading" int, "left" int, "like" int, "limit" int, "natural" int, "not" int, "notnull" int, "null" int, "offset" int, "on" int, "only" int, "or" int, "order" int, "outer" int, "overlaps" int, "pivot" int, "pivot_longer" int, "pivot_wider" int, "placing" int, "positional" int, "primary" int, "qualify" int, "references" int, "replace" int, "returning" int, "right" int, "select" int, "semi" int, "show" int, "similar" int, "some" int, "summarize" int, "symmetric" int, "table" int, "tablesample" int, "then" int, "to" int, "trailing" int, "true" int, "union" int, "unique" int, "unpack" int, "unpivot" int, "using" int, "variadic" int, "verbose" int, "when" int, "where" int, "window" int, "with" int, "MixedAt" int, "we""ird2" text, ts timestamptz);
