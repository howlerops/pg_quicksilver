REVOKE ALL ON public.orders, public.customers FROM qs_c_ok, qs_c_member, qs_c_nosel, qs_c_nocol, qs_c_rls;
DROP ROLE qs_c_ok, qs_c_member, qs_c_nosel, qs_c_nocol, qs_c_rls;
