-- ---------------------------------------------------------------- back as the superuser
\c - postgres
\set VERBOSITY terse
DROP SCHEMA qs_c CASCADE;
NOTICE:  drop cascades to 3 other objects
SELECT quicksilver.prune();
 prune 
-------
     1
