-- ---------------------------------------------------------------- row-level security on the table: the heap's rows
\c - postgres
\set VERBOSITY terse
ALTER TABLE public.customers ENABLE ROW LEVEL SECURITY;
CREATE POLICY qs_c_few ON public.customers FOR SELECT TO qs_c_rls USING (id <= 10);
\c - qs_c_rls
\set VERBOSITY terse
SET quicksilver.route = mirror;
SELECT count(*), min(id), max(id) FROM public.customers;
 count | min | max 
-------+-----+-----
    10 |   1 |  10
(1 row)

:last
 side |             reason             
------+--------------------------------
 heap | construct not on the allowlist
(1 row)

\c - postgres
\set VERBOSITY terse
DROP POLICY qs_c_few ON public.customers;
ALTER TABLE public.customers DISABLE ROW LEVEL SECURITY;
-- ---------------------------------------------------------------- 6. a member is routed the same; the mirror role without its membership is not
\c - qs_c_member
\set VERBOSITY terse
SET quicksilver.route = mirror;
:agg
 count  |     sum      | min |   max   
--------+--------------+-----+---------
 300000 | 149988000.00 |   1 | 1000000
(1 row)

:last
  side  | reason 
--------+--------
 mirror | routed
(1 row)

\c - postgres
\set VERBOSITY terse
REVOKE qs_duck FROM quicksilver_mirror_reader;
\c - qs_c_ok
\set VERBOSITY terse
SET quicksilver.route = mirror;
:agg
 count  |     sum      | min |   max   
--------+--------------+-----+---------
 300000 | 149988000.00 |   1 | 1000000
(1 row)

SELECT side, detail FROM quicksilver.last_decision();
 side |                                      detail                                       
------+-----------------------------------------------------------------------------------
 heap | the mirror role quicksilver_mirror_reader is not a member of duckdb.postgres_role
(1 row)

\c - postgres
\set VERBOSITY terse
GRANT qs_duck TO quicksilver_mirror_reader;
\c - qs_c_ok
\set VERBOSITY terse
SET quicksilver.route = mirror;
:agg
 count  |     sum      | min |   max   
--------+--------------+-----+---------
 300000 | 149988000.00 |   1 | 1000000
