------+--------------------------------+---------------------------------------------------------------------
 heap | construct not on the allowlist | column jt.a.j (stored as a different type in the mirror) and 3 more
(1 row)

-- an ON join that compares j: heap
SELECT a.n FROM jt.a a JOIN jt.c c ON c.j = a.j ORDER BY 1;
