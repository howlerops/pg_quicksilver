SET quicksilver.route = auto;
SET search_path = public;
-- 5. a cached plan made under UTC, run under New York: the plan is reused, so the
--    zone is checked again when it runs. No parameter: a generic plan with an unknown
--    parameter is never routed (the planner says so), a plan without one is reused
SET plan_cache_mode = force_generic_plan;
SET TimeZone = 'UTC';
SET search_path = ex, public;
-- EXPLAIN ANALYZE shows which side each execution took: a reused routed plan records
-- no decision when it runs, so the plan's own line says it
PREPARE dt_p AS SELECT date_trunc('hour', tz) AS h, count(*) FROM t_time WHERE id < 100 AND tz IS NOT NULL GROUP BY 1 ORDER BY 1 LIMIT 3;
EXECUTE dt_p;
              h               | count 
------------------------------+-------
 Tue Jan 06 11:00:00 2015 UTC |     1
 Sun Jan 11 23:00:00 2015 UTC |     1
 Sat Jan 17 11:00:00 2015 UTC |     1
(3 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE dt_p;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Custom Scan (QuicksilverRoute) (actual rows=3 loops=1)
   Quicksilver: mirror
   Mirror Rows: 3
   Mirror Result: held back until complete
   ->  Limit (never executed)
         ->  Sort (never executed)
               Sort Key: (date_trunc('hour'::text, t_time.tz))
               ->  HashAggregate (never executed)
                     Group Key: date_trunc('hour'::text, t_time.tz)
                     ->  Index Scan using t_time_pkey on t_time (never executed)
                           Index Cond: (id < 100)
                           Filter: (tz IS NOT NULL)
(12 rows)

SET TimeZone = 'America/New_York';
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE dt_p;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Custom Scan (QuicksilverRoute) (actual rows=3 loops=1)
   Quicksilver: heap (the session time zone is not proven for this statement)
   ->  Limit (actual rows=3 loops=1)
         ->  Sort (actual rows=3 loops=1)
               Sort Key: (date_trunc('hour'::text, t_time.tz))
               Sort Method: top-N heapsort  Memory: 25kB
               ->  HashAggregate (actual rows=90 loops=1)
                     Group Key: date_trunc('hour'::text, t_time.tz)
                     Batches: 1  Memory Usage: 24kB
                     ->  Index Scan using t_time_pkey on t_time (actual rows=90 loops=1)
                           Index Cond: (id < 100)
                           Filter: (tz IS NOT NULL)
                           Rows Removed by Filter: 9
(13 rows)

SET TimeZone = 'UTC';
EXECUTE dt_p;
              h               | count 
------------------------------+-------
 Tue Jan 06 11:00:00 2015 UTC |     1
 Sun Jan 11 23:00:00 2015 UTC |     1
 Sat Jan 17 11:00:00 2015 UTC |     1
(3 rows)

DEALLOCATE dt_p;
RESET plan_cache_mode;
SET search_path = public;
-- 6. the zone is restored: a failed statement in a block leaves no zone behind, in
--    PostgreSQL or in DuckDB; a SET LOCAL is undone the same way
SET TimeZone = 'UTC';
BEGIN;
SET LOCAL TimeZone = 'America/New_York';
SELECT date_trunc('day', created_at) AS d, count(*) FROM orders GROUP BY 1 ORDER BY 1 LIMIT 2;
              d               | count 
------------------------------+-------
 Sun Dec 31 00:00:00 2023 EST | 17999
 Mon Jan 01 00:00:00 2024 EST | 86400
(2 rows)

:last
  side  | reason |                  detail                  
--------+--------+------------------------------------------
 mirror | routed | 416667 rows from mirrored tables, over 0
(1 row)

SELECT 1 / 0;
ERROR:  division by zero
ROLLBACK;
SHOW TimeZone;
