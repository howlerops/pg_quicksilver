+/*
+ * When duckdb.allowed_directories is configured, an unprivileged user keeps
+ * LocalFileSystem but is confined to those directories (see ConfineToAllowedDirectories).
+ * Without it we fall back to disabling LocalFileSystem outright.
+ */
+static bool
+UseAllowedDirectories() {
+	return !pgduckdb::pg::AllowRawFileAccess() && !IsEmptyString(duckdb_allowed_directories);
+}
+
 static std::string
 DisabledFileSystems() {
-	if (pgduckdb::pg::AllowRawFileAccess()) {
+	if (pgduckdb::pg::AllowRawFileAccess() || UseAllowedDirectories()) {
 		return duckdb_disabled_filesystems;
 	}
 
@@ -300,6 +310,33 @@ DisabledFileSystems() {
 	return "LocalFileSystem," + std::string(duckdb_disabled_filesystems);
 }
 
+/*
+ * Confine an unprivileged backend's filesystem access to the configured
+ * directories, then lock the configuration so the user cannot widen it again
+ * from SQL. Must run last in RefreshConnectionState: once locked, no further
+ * SET succeeds.
+ */
+static void
+ConfineToAllowedDirectories(duckdb::ClientContext &context) {
+	std::vector<std::string> dirs = duckdb::StringUtil::Split(duckdb_allowed_directories, ',');
+	for (auto &dir : dirs) {
+		std::string trimmed = dir;
+		duckdb::StringUtil::Trim(trimmed);
+		if (trimmed.empty()) {
+			continue;
+		}
+		pgduckdb::DuckDBQueryOrThrow(context, "SET allowed_directories=['" + trimmed + "']");
+	}
+	/*
+	 * DuckDB only consults allowed_directories when external access is off:
+	 * CanAccessFile() returns true immediately while enable_external_access is
+	 * set. Turning it off therefore switches the allowlist ON rather than
+	 * denying everything, because allowed_directories is non-empty.
+	 */
+	pgduckdb::DuckDBQueryOrThrow(context, "SET enable_external_access=false");
+	pgduckdb::DuckDBQueryOrThrow(context, "SET lock_configuration=true");
+}
+
 void
 DuckDBManager::RefreshConnectionState(duckdb::ClientContext &context) {
 	std::string disabled_filesystems = DisabledFileSystems();
@@ -334,6 +371,15 @@ DuckDBManager::RefreshConnectionState(duckdb::ClientContext &context) {
 		LoadSecrets(context);
 		secrets_valid = true;
 	}
+
+	/*
+	 * Last: locking the configuration makes every later SET fail, so extension
+	 * loading and secret setup above must already be done.
+	 */
+	if (UseAllowedDirectories() && !filesystem_confined) {
+		ConfineToAllowedDirectories(context);
+		filesystem_confined = true;
+	}
 }
 
