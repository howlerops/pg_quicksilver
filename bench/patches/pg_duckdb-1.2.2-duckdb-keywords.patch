+}
+
+bool
+pgduckdb_is_duckdb_keyword(const char *ident) {
+	const char *key = ident;
+
+	return bsearch(&key, pgduckdb_duckdb_keywords, lengthof(pgduckdb_duckdb_keywords), sizeof(char *),
+	               pgduckdb_duckdb_keyword_cmp) != NULL;
+}
+
+/*
+ * quote_identifier for the SQL pg_duckdb writes for DuckDB: PostgreSQL's, plus
+ * the names in pgduckdb_duckdb_keywords. The vendored deparser (pg_ruleutils)
+ * applies the same rule in its own quote_identifier.
+ */
+const char *
+pgduckdb_quote_identifier(const char *ident) {
+	if (!pgduckdb_is_duckdb_keyword(ident)) {
+		return quote_identifier(ident);
+	}
+	StringInfoData buf;
+	initStringInfo(&buf);
+	appendStringInfoChar(&buf, '"');
+	for (const char *p = ident; *p; p++) {
+		if (*p == '"') {
+			appendStringInfoChar(&buf, '"');
+		}
+		appendStringInfoChar(&buf, *p);
+	}
+	appendStringInfoChar(&buf, '"');
+	return buf.data;
+}
