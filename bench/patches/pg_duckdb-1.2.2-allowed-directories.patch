diff --git a/src/pgduckdb_confined_fs.cpp b/src/pgduckdb_confined_fs.cpp
new file mode 100644
index 0000000..e742ddf
--- /dev/null
+++ b/src/pgduckdb_confined_fs.cpp
@@ -0,0 +1,159 @@
+#include "pgduckdb/pgduckdb_confined_fs.hpp"
+
+#include <atomic>
+#include <string>
+
+#include "duckdb/common/exception.hpp"
+#include "duckdb/common/local_file_system.hpp"
+#include "duckdb/common/memory_mapped_file.hpp"
+#include "duckdb/main/database.hpp"
+
+namespace pgduckdb {
+
+namespace {
+
+/*
+ * One DuckDB instance per backend process, so one flag per process is one flag
+ * per instance. Set only when the configuration has been locked for a role that
+ * may not read or write local files directly.
+ */
+std::atomic<bool> local_writes_denied{false};
+
+/* Anything with a scheme other than file:// belongs to a remote file system. */
+bool
+IsLocalPath(const std::string &path) {
+	return path.find("://") == std::string::npos || path.compare(0, 7, "file://") == 0;
+}
+
+[[noreturn]] void
+ThrowWriteDenied(const std::string &path) {
+	throw duckdb::PermissionException("Cannot write \"%s\": writes to local files are disabled by configuration",
+	                                  path);
+}
+
+/*
+ * A LocalFileSystem that only differs in refusing writes once they are denied.
+ * It keeps the name LocalFileSystem, so duckdb.disabled_filesystems still
+ * disables it by name, exactly as before.
+ */
+class ConfinedLocalFileSystem : public duckdb::LocalFileSystem {
+public:
+	bool
+	CanHandleFile(const std::string &path) override {
+		return IsLocalPath(path);
+	}
+
+	duckdb::unique_ptr<duckdb::FileHandle>
+	OpenFile(const std::string &path, duckdb::FileOpenFlags flags,
+	         duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (flags.OpenForWriting() && local_writes_denied.load()) {
+			ThrowWriteDenied(path);
+		}
+		return duckdb::LocalFileSystem::OpenFile(path, flags, opener);
+	}
+
+	duckdb::unique_ptr<duckdb::MemoryMappedFile>
+	MemoryMapFile(const duckdb::OpenFileInfo &file, duckdb::FileOpenFlags flags, const duckdb::MMapOptions &options,
+	              duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (flags.OpenForWriting() && local_writes_denied.load()) {
+			ThrowWriteDenied(file.path);
+		}
+		return duckdb::LocalFileSystem::MemoryMapFile(file, flags, options, opener);
+	}
+
+	void
+	CreateDirectory(const std::string &directory, duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(directory);
+		}
+		duckdb::LocalFileSystem::CreateDirectory(directory, opener);
+	}
+
+	bool
+	CreateDirectoryExtended(const std::string &directory, const duckdb::CreateDirectoryOptions &options,
+	                        duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(directory);
+		}
+		return duckdb::LocalFileSystem::CreateDirectoryExtended(directory, options, opener);
+	}
+
+	void
+	CreateDirectoriesRecursive(const std::string &path, duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(path);
+		}
+		duckdb::LocalFileSystem::CreateDirectoriesRecursive(path, opener);
+	}
+
+	void
+	RemoveDirectory(const std::string &directory, duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(directory);
+		}
+		duckdb::LocalFileSystem::RemoveDirectory(directory, opener);
+	}
+
+	bool
+	RemoveDirectoryExtended(const std::string &directory, const duckdb::RemoveDirectoryOptions &options,
+	                        duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(directory);
+		}
+		return duckdb::LocalFileSystem::RemoveDirectoryExtended(directory, options, opener);
+	}
+
+	void
+	MoveFile(const std::string &source, const std::string &target,
+	         duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(target);
+		}
+		duckdb::LocalFileSystem::MoveFile(source, target, opener);
+	}
+
+	void
+	RemoveFile(const std::string &filename, duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(filename);
+		}
+		duckdb::LocalFileSystem::RemoveFile(filename, opener);
+	}
+
+	/* A cleanup that is refused is reported as nothing removed, not as an error. */
+	bool
+	TryRemoveFile(const std::string &filename, duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			return false;
+		}
+		return duckdb::LocalFileSystem::TryRemoveFile(filename, opener);
+	}
+
+	void
+	RemoveFiles(const duckdb::vector<std::string> &filenames,
+	            duckdb::optional_ptr<duckdb::FileOpener> opener = nullptr) override {
+		if (local_writes_denied.load()) {
+			ThrowWriteDenied(filenames.empty() ? std::string() : filenames[0]);
+		}
+		duckdb::LocalFileSystem::RemoveFiles(filenames, opener);
+	}
+};
+
+} // namespace
+
+void
+RegisterConfinedLocalFileSystem(duckdb::DatabaseInstance &db) {
+	db.GetFileSystem().RegisterSubSystem(duckdb::make_uniq<ConfinedLocalFileSystem>());
+}
+
+void
+DenyLocalFileWrites() {
+	local_writes_denied.store(true);
+}
+
+void
+AllowLocalFileWrites() {
+	local_writes_denied.store(false);
+}
+
+} // namespace pgduckdb
