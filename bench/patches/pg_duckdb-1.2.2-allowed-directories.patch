+	if (filesystem_confined) {
+		return;
+	}
+
 	std::string disabled_filesystems = DisabledFileSystems();
 	if (disabled_filesystems != "") {
 		/*
@@ -375,6 +410,12 @@ DuckDBManager::RefreshConnectionState(duckdb::ClientContext &context) {
 		LoadSecrets(context);
 		secrets_valid = true;
 	}
+
+	/* Last: after this, the configuration is locked and no refresh can SET anything. */
+	if (UseAllowedDirectories()) {
+		ConfineToAllowedDirectories(context);
+		filesystem_confined = true;
+	}
