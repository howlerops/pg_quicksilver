+/*
+ * Confines the DuckDB instance to duckdb.allowed_directories. The allowlist was
+ * set when the instance was created. DuckDB enforces it on every path (symlinks
+ * and ".." are resolved first), but only while external access is off, so that
+ * is switched off here. The allowlist does not distinguish reads from writes,
+ * so writes are refused by the local file system (pgduckdb_confined_fs.cpp).
+ * The configuration is locked last: a locked configuration rejects every SET,
+ * so nothing can widen the allowlist, turn external access back on, or unlock.
+ */
+static void
+ConfineToAllowedDirectories(duckdb::ClientContext &context) {
+	pgduckdb::DuckDBQueryOrThrow(context, "SET enable_external_access=false");
+	pgduckdb::DuckDBQueryOrThrow(context, "SET lock_configuration=true");
+	pgduckdb::DenyLocalFileWrites();
+}
+
