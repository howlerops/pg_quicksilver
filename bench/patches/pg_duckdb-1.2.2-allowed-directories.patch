@@ -0,0 +1,27 @@
+#pragma once
+
+namespace duckdb {
+class DatabaseInstance;
+}
+
+namespace pgduckdb {
+
+/*
+ * Registers the LocalFileSystem that handles every local path. Until
+ * DenyLocalFileWrites() is called it behaves exactly like LocalFileSystem.
+ * Once it is called, every operation that can create, change or remove a local
+ * file fails. Reads are not touched here: they are confined by DuckDB's own
+ * allowed_directories allowlist, which DuckDB enforces on every path.
+ *
+ * It must be registered before the CA certificate file system, so that the
+ * exact CA bundle paths still go to that file system.
+ */
+void RegisterConfinedLocalFileSystem(duckdb::DatabaseInstance &db);
+
+/* Called once the DuckDB configuration is locked for a confined role. */
+void DenyLocalFileWrites();
+
+/* Called when the DuckDB instance is discarded, so the next one starts unrestricted. */
+void AllowLocalFileWrites();
+
+} // namespace pgduckdb
